NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

STORAGE_BUCKET_EVIDENCE_ORIGINALS=evidence-originals

# E2E (Playwright) — set in .env.local, .env.e2e.local (overrides .env.local), or shell; never commit secrets.
# LEXOS_E2E_BASE_URL=http://localhost:3000
# LEXOS_E2E_EMAIL=
# LEXOS_E2E_PASSWORD=
# If the password contains #, quote LEXOS_E2E_PASSWORD in .env or use a one-line file:
# LEXOS_E2E_PASSWORD_FILE=.e2e-password.txt
# LEXOS_E2E_MATTER_ID=
# LEXOS_E2E_SKIP_WEBSERVER=1
# LEXOS_E2E_BOOTSTRAP_AUTH=1
# When 1, Playwright global setup uses SUPABASE_SERVICE_ROLE_KEY to create or update
# the LEXOS_E2E_EMAIL user password to match env, and seeds a minimal client+matter
# for WP-06 when none exist (local/CI only; never commit the key).

LLM_PROVIDER=
LLM_API_KEY=

PARSER_PROVIDER=
PARSER_API_KEY=

VISION_PROVIDER=
VISION_API_KEY=

EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

ENABLE_EMBEDDINGS=
ENABLE_AUDIO_INGEST=
ENABLE_VIDEO_INGEST=
